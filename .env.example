# GitLab: shared secret for the webhook (sent as X-Gitlab-Token)
GITLAB_SECRET=

# GitLab Personal Access Token (api scope)
GITLAB_TOKEN=

# GitLab API URL (gitlab.com or self-hosted)
GITLAB_BASE_URL=https://gitlab.com/api/v4

# User id of the account the bot posts as. Set this: without it the bot's own
# summary comment retriggers the webhook and the review loops.
GITLAB_BOT_USER_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional
APP_ENV=development
LOG_LEVEL=INFO
