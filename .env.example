# GitLab: секрет для Webhook (X-Gitlab-Token)
GITLAB_SECRET=ai-review-secret-123

# GitLab Personal Access Token (с правами api)
GITLAB_TOKEN=glpat-YOUR_TOKEN_HERE

# GitLab API URL (gitlab.com или self-hosted)
GITLAB_BASE_URL=https://gitlab.com/api/v4

# OpenAI
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# Доп. настройки (необязательно переопределять в .env)
APP_ENV=development
LOG_LEVEL=INFO
